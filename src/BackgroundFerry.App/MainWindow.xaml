<Window x:Class="BackgroundFerry.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Background Ferry" Width="1100" Height="790" MinWidth="970" MinHeight="700"
 WindowStartupLocation="CenterScreen" Background="#101217" Foreground="#F0F2F5" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#9199AB"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#252A35"/><Setter Property="Foreground" Value="#EFF3F5"/><Setter Property="Padding" Value="18,12"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8CE6BE"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="Background" Value="#303746"/><Setter Property="Foreground" Value="#F0F2F5"/><Setter Property="BorderBrush" Value="#4B5769"/><Setter Property="Padding" Value="14"/><Setter Property="MaxWidth" Value="340"/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="21"/></DataTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Info" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Content" Value="i"/><Setter Property="Width" Value="23"/><Setter Property="Height" Value="23"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="8,0,0,0"/>
   <Setter Property="FontFamily" Value="Georgia"/><Setter Property="FontStyle" Value="Italic"/><Setter Property="Foreground" Value="#A9B3C5"/>
   <Setter Property="ToolTipService.InitialShowDelay" Value="200"/><Setter Property="ToolTipService.ShowDuration" Value="60000"/><Setter Property="AutomationProperties.Name" Value="{DynamicResource Help}"/>
   <EventSetter Event="GotKeyboardFocus" Handler="Info_Focus"/><EventSetter Event="LostKeyboardFocus" Handler="Info_Blur"/>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E0E5EE"/><Setter Property="Margin" Value="0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#E8EDF4"/><Setter Property="Background" Value="#242A35"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="#E8EDF4"/><Setter Property="Background" Value="#242A35"/><Setter Property="Padding" Value="12,8"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
     <Border x:Name="Item" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
     <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#3D4B52"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#304B41"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#242A35" CornerRadius="8" BorderBrush="#353C49" BorderThickness="1"><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#9AA5B6"/></Border></ControlTemplate></ToggleButton.Template>
    </ToggleButton><ContentPresenter IsHitTestVisible="False" Margin="12,10,32,10" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="#242A35" BorderBrush="#353C49" BorderThickness="1" CornerRadius="6"><ScrollViewer MaxHeight="250"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Margin" Value="0,12,0,0"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="Height" Value="24"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid><Track x:Name="PART_Track" VerticalAlignment="Center">
     <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="4" CornerRadius="2" Background="#8CE6BE"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="15" Height="15"><Thumb.Template><ControlTemplate><Ellipse Fill="#A4F2CF" Stroke="#101217" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="4" CornerRadius="2" Background="#343B49"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track></Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ProgressBar"><Setter Property="Height" Value="5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#303845"/><Setter Property="Foreground" Value="#8CE6BE"/><Setter Property="Maximum" Value="100"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#191D26"/><Setter Property="BorderBrush" Value="#2A303C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/></Style>
  <Style x:Key="Nav" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#939CAF"/><Setter Property="Margin" Value="12,5"/><Setter Property="Padding" Value="16,13"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Surface" CornerRadius="9" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#23332E"/><Setter Property="Foreground" Value="#9BEBCA"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".75"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8CE6BE"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="194"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#14171E" BorderBrush="#262B36" BorderThickness="0,0,1,0"><DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="25,29,10,35"><TextBlock Text="≈" FontSize="40" Foreground="#8CE6BE" Height="47"/><TextBlock Text="Background" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Ferry" FontSize="19" Foreground="#8CE6BE"/></StackPanel>
   <TextBlock DockPanel.Dock="Bottom" Text="v0.2.0" Foreground="#657084" Margin="29,20"/>
   <StackPanel><RadioButton x:Name="MixerNav" Content="{DynamicResource Mixer}" Style="{StaticResource Nav}" GroupName="Page" IsChecked="True" Checked="Navigate"/><RadioButton x:Name="TabsNav" Content="{DynamicResource Tabs}" Style="{StaticResource Nav}" GroupName="Page" Checked="Navigate"/><RadioButton x:Name="SettingsNav" Content="{DynamicResource Settings}" Style="{StaticResource Nav}" GroupName="Page" Checked="Navigate"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="30,30,30,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,25"><StackPanel><TextBlock Text="{DynamicResource Title}" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Subtitle}" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><ComboBox x:Name="LanguagePicker" Width="86" HorizontalAlignment="Right" VerticalAlignment="Top" SelectionChanged="Language_Changed" AutomationProperties.Name="{DynamicResource Language}"><ComboBoxItem Content="RU"/><ComboBoxItem Content="EN"/></ComboBox>
   </Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><Grid>
    <StackPanel x:Name="MixerPage">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,17"><TextBlock Text="{DynamicResource Music}" FontSize="17" FontWeight="SemiBold"/><Button Style="{StaticResource Info}" ToolTip="{DynamicResource MusicTip}"/></StackPanel>
       <ComboBox x:Name="MusicPicker" DisplayMemberPath="Name" SelectedValuePath="Process" SelectionChanged="Music_Changed" AutomationProperties.Name="{DynamicResource Music}"/>
       <ProgressBar x:Name="MusicMeter" Margin="0,22,0,0" AutomationProperties.Name="{DynamicResource Music}"/><TextBlock x:Name="MusicLevel" Foreground="{StaticResource Muted}" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="{DynamicResource Priority}" FontSize="17" FontWeight="SemiBold"/><Button Style="{StaticResource Info}" ToolTip="{DynamicResource PriorityTip}"/></StackPanel>
       <ScrollViewer Height="96" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="PriorityList"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanPrioritize}" Checked="Priority_Changed" Unchecked="Priority_Changed"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="185"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{DynamicResource MixControl}" FontSize="18" FontWeight="SemiBold"/><Button Style="{StaticResource Info}" ToolTip="{DynamicResource ModeTip}"/></StackPanel><ComboBox x:Name="ModePicker" Grid.Column="1" SelectionChanged="Setting_Changed" AutomationProperties.Name="{DynamicResource MixControl}"><ComboBoxItem Content="{DynamicResource Steady}"/><ComboBoxItem Content="{DynamicResource Adaptive}"/></ComboBox></Grid>
      <Grid Margin="0,25,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Info}" ToolTip="{DynamicResource DuckTip}"/><TextBlock x:Name="DuckLabel"/></DockPanel><Slider x:Name="DuckSlider" Minimum="1" Maximum="60" TickFrequency="1" ValueChanged="Setting_Changed" AutomationProperties.Name="{DynamicResource Duck}"/></StackPanel>
       <StackPanel Grid.Column="2"><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Info}" ToolTip="{DynamicResource SensitivityTip}"/><TextBlock x:Name="ThresholdLabel"/></DockPanel><Slider x:Name="ThresholdSlider" Minimum="-70" Maximum="-10" TickFrequency="1" ValueChanged="Setting_Changed" AutomationProperties.Name="{DynamicResource Sensitivity}"/></StackPanel>
      </Grid>
      <Border Height="1" Background="#2C3340" Margin="0,21"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Info}" ToolTip="{DynamicResource AttackTip}"/><TextBlock x:Name="AttackLabel" FontSize="12" TextWrapping="Wrap"/></DockPanel><Slider x:Name="AttackSlider" Minimum="50" Maximum="1000" TickFrequency="50" ValueChanged="Setting_Changed" AutomationProperties.Name="{DynamicResource Attack}"/></StackPanel>
       <StackPanel Grid.Column="2"><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Info}" ToolTip="{DynamicResource HoldTip}"/><TextBlock x:Name="HoldLabel" FontSize="12" TextWrapping="Wrap"/></DockPanel><Slider x:Name="HoldSlider" Minimum="200" Maximum="5000" TickFrequency="100" ValueChanged="Setting_Changed" AutomationProperties.Name="{DynamicResource Hold}"/></StackPanel>
       <StackPanel Grid.Column="4"><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Info}" ToolTip="{DynamicResource ReleaseTip}"/><TextBlock x:Name="ReleaseLabel" FontSize="12" TextWrapping="Wrap"/></DockPanel><Slider x:Name="ReleaseSlider" Minimum="200" Maximum="5000" TickFrequency="100" ValueChanged="Setting_Changed" AutomationProperties.Name="{DynamicResource Release}"/></StackPanel>
      </Grid>
     </StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="TabsPage" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="{DynamicResource TabsTitle}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource TabsIntro}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,13,0,25"/>
     <TextBlock Text="{DynamicResource TabsSteps}" TextWrapping="Wrap" LineHeight="30" Margin="0,0,0,24"/>
     <WrapPanel><Button Content="{DynamicResource OpenFolder}" Click="ExtensionFolder_Click" Background="#8CE6BE" Foreground="#10241B" Margin="0,0,12,12"/><Button Content="{DynamicResource CopyAddress}" Click="CopyAddress_Click" Margin="0,0,0,12"/><Button Style="{StaticResource Info}" ToolTip="{DynamicResource TabsTip}" VerticalAlignment="Top" Margin="12,10,0,0"/></WrapPanel><TextBlock x:Name="TabsNotice" Foreground="#8CE6BE" TextWrapping="Wrap"/>
    </StackPanel></Border></StackPanel>
    <StackPanel x:Name="SettingsPage" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="{DynamicResource Settings}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource SettingsSubtitle}" Foreground="{StaticResource Muted}" Margin="0,10,0,25"/>
     <StackPanel Orientation="Horizontal"><CheckBox x:Name="StartupCheck" Content="{DynamicResource Startup}" Checked="Startup_Changed" Unchecked="Startup_Changed"/><Button Style="{StaticResource Info}" ToolTip="{DynamicResource StartupTip}"/></StackPanel>
     <StackPanel Orientation="Horizontal"><CheckBox x:Name="MinimizedCheck" Content="{DynamicResource Minimized}" Checked="Preference_Changed" Unchecked="Preference_Changed"/><Button Style="{StaticResource Info}" ToolTip="{DynamicResource MinimizedTip}"/></StackPanel>
     <Border Height="1" Background="#2C3340" Margin="0,20"/>
     <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource Language}" VerticalAlignment="Center"/><Button Style="{StaticResource Info}" ToolTip="{DynamicResource LanguageTip}"/><Button Content="Русский" Tag="ru" Click="SetLanguage_Click" Margin="20,0,10,0"/><Button Content="English" Tag="en" Click="SetLanguage_Click"/></StackPanel>
    </StackPanel></Border></StackPanel>
   </Grid></ScrollViewer>
   <TextBlock x:Name="Notice" Grid.Row="2" Foreground="#EAC589" TextWrapping="Wrap" Margin="2,12,2,0" FontSize="12"/>
   <Border x:Name="MixFooter" Grid.Row="3" Style="{StaticResource Card}" Padding="20,18" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="125"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="Status" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="StatusDetail" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,12,0" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="GainLabel" FontSize="11" Foreground="#8CE6BE" Margin="0,0,0,8"/><ProgressBar x:Name="GainMeter" Value="100" AutomationProperties.Name="{DynamicResource Gain}"/></StackPanel>
    <Button x:Name="ToggleButton" Grid.Column="3" Background="#8CE6BE" Foreground="#10241B" FontWeight="SemiBold" MinWidth="145" Click="Toggle_Click"/>
   </Grid></Border>
  </Grid>
 </Grid>
</Window>
