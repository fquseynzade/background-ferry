<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BackgroundFerry</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>BackgroundFerry.App.Program</StartupObject>
    <ApplicationIcon>Assets/ferry.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../BackgroundFerry.Windows/BackgroundFerry.Windows.csproj" /></ItemGroup>
</Project>
